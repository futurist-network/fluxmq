{
  "schema": 1,
  "kind": "system",
  "run_id": "kafka-cluster-fsync-system",
  "system_name": "kafka-cluster-fsync",
  "system_title": "Kafka 3 nodes RF=3, fsync before ack (log.flush.interval.messages=1)",
  "system": "kafka",
  "startup_s": 10.9,
  "broker_version": "Apache Kafka 3.7.0",
  "nodes": [
    "kafka1",
    "kafka2",
    "kafka3"
